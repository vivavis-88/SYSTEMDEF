-- ============================================================
-- BOOTH / MEMOLOG - PostgreSQL schema  (Blueprint v1.0, section 7)
--
-- 1) Create the database once. In pgAdmin: right-click Databases >
--    Create > Database, name it  logsystem  (encoding UTF8).
--    Or in a terminal:  createdb -U postgres logsystem
-- 2) Connect to logsystem, then run this file, then seed.sql.
--
-- Safe to re-import: it drops the tables first (development only!).
-- MySQL -> PostgreSQL translation used here:
--   AUTO_INCREMENT      -> GENERATED BY DEFAULT AS IDENTITY
--   UNSIGNED            -> plain integer (+ CHECK >= 0 where it matters)
--   TINYINT(1)          -> BOOLEAN
--   DATETIME            -> TIMESTAMP
--   ENUM(...)           -> VARCHAR + CHECK (... IN (...))
--   UNIQUE(email)       -> unique index on lower(email)  (PostgreSQL is case-sensitive)
-- ============================================================

DROP TABLE IF EXISTS entries, sales, items, categories, vendors, event_days,
    trusted_devices, workspace_members, role_permissions, workspaces, otp_codes,
    user_preferences, users, entry_kinds, item_types, permissions, roles, themes,
    account_types CASCADE;

-- ============================================================
-- LOOKUP TABLES
-- ============================================================
CREATE TABLE account_types (
    id    SMALLINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    code  VARCHAR(20) NOT NULL,
    label VARCHAR(40) NOT NULL,
    CONSTRAINT uq_account_type_code UNIQUE (code)
);
CREATE TABLE themes (
    id    SMALLINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    code  VARCHAR(20) NOT NULL,
    label VARCHAR(40) NOT NULL,
    CONSTRAINT uq_theme_code UNIQUE (code)
);
CREATE TABLE roles (
    id    SMALLINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    code  VARCHAR(20) NOT NULL,
    label VARCHAR(40) NOT NULL,
    CONSTRAINT uq_role_code UNIQUE (code)
);
CREATE TABLE permissions (
    id    SMALLINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    code  VARCHAR(40) NOT NULL,
    label VARCHAR(80) NOT NULL,
    CONSTRAINT uq_permission_code UNIQUE (code)
);
CREATE TABLE item_types (
    id    SMALLINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    code  VARCHAR(20) NOT NULL,
    label VARCHAR(40) NOT NULL,
    CONSTRAINT uq_item_type_code UNIQUE (code)
);
CREATE TABLE entry_kinds (
    id    SMALLINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    code  VARCHAR(20) NOT NULL,
    label VARCHAR(40) NOT NULL,
    CONSTRAINT uq_entry_kind_code UNIQUE (code)
);

-- ============================================================
-- IDENTITY AND SECURITY
-- ============================================================
CREATE TABLE users (
    id                INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    email             VARCHAR(190) NULL,        -- cashiers may have no email
    password_hash     VARCHAR(255) NULL,        -- cashiers may have no password
    pin_hash          VARCHAR(255) NOT NULL,
    display_name      VARCHAR(80)  NOT NULL,
    email_verified_at TIMESTAMP NULL,
    failed_attempts   SMALLINT NOT NULL DEFAULT 0 CHECK (failed_attempts >= 0),
    locked_until      TIMESTAMP NULL,
    created_at        TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);
-- Case-insensitive unique email. Many NULLs are allowed. In PHP always compare
-- with:  WHERE lower(email) = lower(:email)
CREATE UNIQUE INDEX uq_user_email ON users (lower(email));

CREATE TABLE user_preferences (
    user_id       INTEGER PRIMARY KEY,
    show_tutorial BOOLEAN NOT NULL DEFAULT TRUE,
    sound_on      BOOLEAN NOT NULL DEFAULT TRUE,
    CONSTRAINT fk_pref_user FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
);

CREATE TABLE otp_codes (
    id         INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    user_id    INTEGER NOT NULL,
    purpose    VARCHAR(20) NOT NULL CHECK (purpose IN ('signup', 'pin_reset', 'device')),
    code_hash  CHAR(64) NOT NULL,               -- hash only, never the code
    expires_at TIMESTAMP NOT NULL,
    attempts   SMALLINT NOT NULL DEFAULT 0 CHECK (attempts >= 0),
    used_at    TIMESTAMP NULL,
    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_otp_user FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
);
CREATE INDEX idx_otp_user ON otp_codes (user_id, purpose);

-- ============================================================
-- ACCESS AND WORKSPACE
-- ============================================================
CREATE TABLE workspaces (
    id               INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    account_type_id  SMALLINT NOT NULL,
    owner_user_id    INTEGER  NOT NULL,
    theme_id         SMALLINT NOT NULL,
    name             VARCHAR(100) NOT NULL,
    slug             VARCHAR(40)  NOT NULL,
    commission_rate  NUMERIC(5,2) NOT NULL DEFAULT 0 CHECK (commission_rate BETWEEN 0 AND 100),
    currency         CHAR(3) NOT NULL DEFAULT 'PHP',
    show_member_list BOOLEAN NOT NULL DEFAULT TRUE,
    created_at       TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT uq_workspace_slug UNIQUE (slug),
    CONSTRAINT fk_ws_type  FOREIGN KEY (account_type_id) REFERENCES account_types(id) ON DELETE RESTRICT,
    CONSTRAINT fk_ws_owner FOREIGN KEY (owner_user_id)   REFERENCES users(id)         ON DELETE RESTRICT,
    CONSTRAINT fk_ws_theme FOREIGN KEY (theme_id)        REFERENCES themes(id)        ON DELETE RESTRICT
);

CREATE TABLE role_permissions (
    role_id       SMALLINT NOT NULL,
    permission_id SMALLINT NOT NULL,
    PRIMARY KEY (role_id, permission_id),
    CONSTRAINT fk_rp_role FOREIGN KEY (role_id)       REFERENCES roles(id)       ON DELETE CASCADE,
    CONSTRAINT fk_rp_perm FOREIGN KEY (permission_id) REFERENCES permissions(id) ON DELETE CASCADE
);

CREATE TABLE workspace_members (
    workspace_id INTEGER  NOT NULL,
    user_id      INTEGER  NOT NULL,
    role_id      SMALLINT NOT NULL,
    status       VARCHAR(10) NOT NULL DEFAULT 'active' CHECK (status IN ('active', 'removed')),
    joined_at    TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (workspace_id, user_id),
    CONSTRAINT fk_wm_ws   FOREIGN KEY (workspace_id) REFERENCES workspaces(id) ON DELETE CASCADE,
    CONSTRAINT fk_wm_user FOREIGN KEY (user_id)      REFERENCES users(id)      ON DELETE RESTRICT,
    CONSTRAINT fk_wm_role FOREIGN KEY (role_id)      REFERENCES roles(id)      ON DELETE RESTRICT
);
CREATE INDEX idx_wm_user ON workspace_members (user_id);

CREATE TABLE trusted_devices (
    id           INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    user_id      INTEGER NOT NULL,
    workspace_id INTEGER NOT NULL,
    token_hash   CHAR(64) NOT NULL,             -- SHA-256 of the cookie token
    label        VARCHAR(120) NULL,
    expires_at   TIMESTAMP NOT NULL,
    last_used_at TIMESTAMP NULL,
    created_at   TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT uq_device_token UNIQUE (token_hash),
    CONSTRAINT fk_td_user FOREIGN KEY (user_id)      REFERENCES users(id)      ON DELETE CASCADE,
    CONSTRAINT fk_td_ws   FOREIGN KEY (workspace_id) REFERENCES workspaces(id) ON DELETE CASCADE
);
CREATE INDEX idx_td_user ON trusted_devices (user_id);
CREATE INDEX idx_td_ws   ON trusted_devices (workspace_id);

-- ============================================================
-- BUSINESS LOG
-- ============================================================
CREATE TABLE event_days (
    id           INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    workspace_id INTEGER  NOT NULL,
    day_no       SMALLINT NOT NULL CHECK (day_no >= 1),
    event_date   DATE NULL,
    CONSTRAINT uq_day UNIQUE (workspace_id, day_no),
    CONSTRAINT fk_day_ws FOREIGN KEY (workspace_id) REFERENCES workspaces(id) ON DELETE CASCADE
);

CREATE TABLE vendors (
    id           INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    workspace_id INTEGER NOT NULL,
    name         VARCHAR(80) NOT NULL,
    is_house     BOOLEAN NOT NULL DEFAULT FALSE,   -- the booth itself keeps 100%
    CONSTRAINT uq_vendor UNIQUE (workspace_id, name),
    CONSTRAINT fk_ven_ws FOREIGN KEY (workspace_id) REFERENCES workspaces(id) ON DELETE CASCADE
);

CREATE TABLE categories (
    id           INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    workspace_id INTEGER NOT NULL,
    name         VARCHAR(60) NOT NULL,
    color        CHAR(7) NOT NULL,                 -- #RRGGBB, regex checked in PHP
    CONSTRAINT uq_category UNIQUE (workspace_id, name),
    CONSTRAINT fk_cat_ws FOREIGN KEY (workspace_id) REFERENCES workspaces(id) ON DELETE CASCADE
);

CREATE TABLE items (
    id           INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    workspace_id INTEGER  NOT NULL,
    vendor_id    INTEGER  NOT NULL,
    category_id  INTEGER  NULL,
    item_type_id SMALLINT NULL,
    name         VARCHAR(120) NOT NULL,
    price        NUMERIC(10,2) NOT NULL CHECK (price >= 0),
    starting_qty INTEGER NULL CHECK (starting_qty >= 0),
    CONSTRAINT uq_item UNIQUE (workspace_id, vendor_id, name, price),
    CONSTRAINT fk_item_ws  FOREIGN KEY (workspace_id) REFERENCES workspaces(id) ON DELETE CASCADE,
    CONSTRAINT fk_item_ven FOREIGN KEY (vendor_id)    REFERENCES vendors(id)    ON DELETE RESTRICT,
    CONSTRAINT fk_item_cat FOREIGN KEY (category_id)  REFERENCES categories(id) ON DELETE SET NULL,
    CONSTRAINT fk_item_typ FOREIGN KEY (item_type_id) REFERENCES item_types(id) ON DELETE SET NULL
);
CREATE INDEX idx_item_vendor   ON items (vendor_id);
CREATE INDEX idx_item_category ON items (category_id);

-- Total is calculated (qty * unit_price), never stored.
-- unit_price is a snapshot of the price actually charged.
-- Deleting a workspace: the model deletes sales first (items are RESTRICTed
-- by sales), then the workspace, all inside one transaction.
CREATE TABLE sales (
    id              BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    workspace_id    INTEGER NOT NULL,
    item_id         INTEGER NOT NULL,
    event_day_id    INTEGER NOT NULL,
    cashier_user_id INTEGER NOT NULL,
    qty             INTEGER NOT NULL CHECK (qty >= 1),
    unit_price      NUMERIC(10,2) NOT NULL CHECK (unit_price >= 0),
    sold_at         TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_sale_ws   FOREIGN KEY (workspace_id)    REFERENCES workspaces(id) ON DELETE CASCADE,
    CONSTRAINT fk_sale_item FOREIGN KEY (item_id)         REFERENCES items(id)      ON DELETE RESTRICT,
    CONSTRAINT fk_sale_day  FOREIGN KEY (event_day_id)    REFERENCES event_days(id) ON DELETE RESTRICT,
    CONSTRAINT fk_sale_user FOREIGN KEY (cashier_user_id) REFERENCES users(id)      ON DELETE RESTRICT
);
CREATE INDEX idx_sale_ws_day ON sales (workspace_id, event_day_id);
CREATE INDEX idx_sale_item   ON sales (item_id);
CREATE INDEX idx_sale_day    ON sales (event_day_id);
CREATE INDEX idx_sale_user   ON sales (cashier_user_id);

-- ============================================================
-- PERSONAL LOG
-- ============================================================
CREATE TABLE entries (
    id           BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    workspace_id INTEGER  NOT NULL,
    category_id  INTEGER  NULL,
    kind_id      SMALLINT NOT NULL,
    created_by   INTEGER  NOT NULL,
    amount       NUMERIC(12,2) NULL CHECK (amount >= 0),   -- NULL for notes
    entry_date   DATE NOT NULL,
    description  VARCHAR(255) NULL,
    created_at   TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_entry_ws   FOREIGN KEY (workspace_id) REFERENCES workspaces(id)  ON DELETE CASCADE,
    CONSTRAINT fk_entry_cat  FOREIGN KEY (category_id)  REFERENCES categories(id)  ON DELETE SET NULL,
    CONSTRAINT fk_entry_kind FOREIGN KEY (kind_id)      REFERENCES entry_kinds(id) ON DELETE RESTRICT,
    CONSTRAINT fk_entry_user FOREIGN KEY (created_by)   REFERENCES users(id)       ON DELETE RESTRICT
);
CREATE INDEX idx_entry_ws_date ON entries (workspace_id, entry_date);
CREATE INDEX idx_entry_cat     ON entries (category_id);
CREATE INDEX idx_entry_user    ON entries (created_by);


